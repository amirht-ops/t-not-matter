{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tenant-service-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId", "WithThreadId", "WithEnvironmentName", "WithMachineName" ],
    "Properties": {
      "ServiceName": "TenantService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Tenant": "Host=localhost;Port=5432;Database=tenant_db;Username=postgres;Password=123456789"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "enterprise-auth-platform",
    "Audience": "enterprise-services"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "security.events"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalMilliseconds": 500,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 10
  },
  "Services": {
    "AuthorizationService": {
      "BaseUrl": "http://localhost:5108",
      "TimeoutSeconds": 5,
      "RetryCount": 1,
      "CircuitBreakerThreshold": 3,
      "CircuitBreakerDurationSeconds": 30
    }
  },
  "Middleware": {
    "EnableRateLimiting": true,
    "RateLimiting": {
      "DefaultPermitLimit": 100,
      "DefaultWindowSeconds": 60,
      "UseClientIpAsKey": true
    }
  },
  "AllowedHosts": "*"
}
