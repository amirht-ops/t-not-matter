{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/authorization-service-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId", "WithThreadId", "WithEnvironmentName", "WithMachineName" ],
    "Properties": {
      "ServiceName": "AuthorizationService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Authorization": "Host=localhost;Port=5432;Database=authorization_db;Username=postgres;Password=123456789"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "enterprise-auth-platform",
    "Audience": "enterprise-services"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "security.events"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalMilliseconds": 500,
    "LeaseDurationSeconds": 30,
    "MaxAttempts": 10
  },
  "Behaviors": {
    "EnableAuthorization": true,
    "EnableAudit": true,
    "EnableUnitOfWork": true,
    "EnablePerformanceWarnings": true,
    "EnableIdempotency": true,
    "EnableCaching": true,
    "EnableMetrics": true,
    "EnableRetry": true
  },
  "Middleware": {
    "EnableRateLimiting": true,
    "RateLimiting": {
      "DefaultPermitLimit": 100,
      "DefaultWindowSeconds": 60,
      "UseClientIpAsKey": true
    }
  },
  "AuthorizationCache": {
    "Enabled": true,
    "EffectivePermissionsTtlSeconds": 5,
    "DecisionCacheEnabled": true,
    "DecisionCacheTtlSeconds": 5
  },
  "Services": {
    "TenantService": {
      "BaseUrl": "http://localhost:5068",
      "TimeoutMs": 5000
    }
  },
  "AllowedHosts": "*"
}
