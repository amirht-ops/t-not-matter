{
  "ConnectionStrings": {
    "Policy": "Host=localhost;Port=5432;Database=policyservice;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "policy"
  },
  "Opa": {
    "BaseUrl": "http://localhost:8181",
    "PolicyPath": "/v1/data/policy/allow",
    "TimeoutMs": 1000,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "RetryCount": 2
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "policy.events"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMilliseconds": 10000,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 10
  },
  "Jwt": {
    "Issuer": "enterprise-auth-platform",
    "Audience": "enterprise-services"
  },
  "Behaviors": {
    "EnableAuthorization": true,
    "EnableUnitOfWork": true,
    "EnableIdempotency": true,
    "EnableCaching": true,
    "EnableRetry": true,
    "EnableMetrics": true,
    "EnablePerformanceWarnings": true,
    "EnableFailClosed": true,
    "EnableAudit": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
